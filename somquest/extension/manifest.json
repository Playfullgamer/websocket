{
  "manifest_version": 3,
  "name": "SomQuest — Het Laatste Rapport",
  "version": "1.0.0",
  "description": "Een complete verhaalgame-mod voor Somtoday: 5 hoofdstukken, bazen, lore, geluid en effecten.",
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.somtoday.nl/*"
      ],
      "js": [
        "somquest.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
